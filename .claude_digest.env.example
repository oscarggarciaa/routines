# Copia este archivo a ~/.claude_digest.env y rellena los valores
# cp /home/user/routines/.claude_digest.env.example ~/.claude_digest.env

# API Key de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Cuenta Gmail desde la que se envía el digest
DIGEST_EMAIL_FROM=tu_cuenta@gmail.com

# App Password de Gmail (NO tu contraseña normal)
# Cómo generarla: https://myaccount.google.com/apppasswords
# Requisito: tener verificación en dos pasos activada
DIGEST_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Destinatario (por defecto ya está configurado)
DIGEST_EMAIL_TO=ogarcia@seidor.es
