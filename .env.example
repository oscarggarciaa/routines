# =============================================================================
# Digest Semanal de Claude — Configuración
# Copia a .env y rellena los valores que necesites
# =============================================================================

# --- Obsidian Vault ---
# Ruta absoluta a tu vault de Obsidian (obligatorio para guardar notas)
# Ejemplos:
#   Mac:     /Users/oscar/Documents/Obsidian/MyVault
#   Windows: C:/Users/oscar/Documents/Obsidian/MyVault
#   Linux:   /home/oscar/Obsidian/MyVault
OBSIDIAN_VAULT_PATH=/Users/oscar/Documents/Obsidian/MyVault

# Carpeta dentro del vault donde se guardarán las notas (se crea si no existe)
# OBSIDIAN_FOLDER=Novedades Claude

# --- Destinatario del email ---
# RECIPIENT_EMAIL=ogarcia@seidor.es

# --- (Opcional) Ruta al mcp-config de Gmail si no se detecta automáticamente ---
# MCP_CONFIG_PATH=/tmp/mcp-config-cse_xxxx.json
