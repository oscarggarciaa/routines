# =============================================================================
# Configuración del Digest Semanal de Claude
# Copia este archivo a .env y rellena los valores
# =============================================================================

# --- Anthropic API ---
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (SMTP) ---
# Opción A: Gmail con App Password (recomendado)
#   1. Activa 2FA en tu cuenta Google
#   2. Ve a: Google Account > Security > App Passwords
#   3. Genera una contraseña de aplicación para "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Opción B: Outlook / Microsoft 365
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USER=tu.cuenta@outlook.com
# SMTP_PASSWORD=tu_contraseña

# --- Destinatario ---
RECIPIENT_EMAIL=ogarcia@seidor.es

# --- Email remitente (por defecto usa SMTP_USER) ---
# SENDER_EMAIL=tu.cuenta@gmail.com
