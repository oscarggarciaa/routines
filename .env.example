# ── Claude API ────────────────────────────────────────────────────────────────
# Obten tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Destinatario del digest ───────────────────────────────────────────────────
RECIPIENT_EMAIL=ogarcia@seidor.es

# ── Configuración SMTP para enviar el email ───────────────────────────────────
# Opción A: Gmail (requiere una "App Password", no tu contraseña normal)
#   Ve a: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # App Password de 16 caracteres
SENDER_EMAIL=tu_cuenta@gmail.com

# Opción B: Outlook / Office 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu_cuenta@outlook.com
# SMTP_PASSWORD=tu_contraseña
# SENDER_EMAIL=tu_cuenta@outlook.com

# Opción C: SMTP corporativo Seidor (consulta con IT el host y puerto)
# SMTP_HOST=mail.seidor.com
# SMTP_PORT=587
# SMTP_USER=ogarcia@seidor.es
# SMTP_PASSWORD=tu_contraseña
# SENDER_EMAIL=ogarcia@seidor.es
